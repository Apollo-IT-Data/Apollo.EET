<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <PackageId>Apollo.Mews.Eet</PackageId>
    <Product>Apollo.Mews.Eet</Product>
    <Authors>Apollo IT Data</Authors>
    <Description>Client for EET 2.0 - Czech fiscal machines (Apollo fork).</Description>
    <RepositoryUrl>https://github.com/Apollo-IT-Data/fiscalization-czechia</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/Apollo-IT-Data/fiscalization-czechia</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>EET Fiscal Receipt</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <!-- Version is supplied by CI from the git tag (v*) -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Security.Cryptography.Xml" Version="10.0.11" />
  </ItemGroup>
</Project>